## Default Configuration

```mjs
{
	paths: {
		plans: './plans',
		project: './project',
		prompts: './prompts'
		tests: './tests',
		artifacts: './tests/artifacts',
	}

	sequences: {
		development: {
			max_flow_runs: 3,
			agents: [
				'WRITE_USER_STORIES',
				'GENERATE_CODE',
				'PLAN_TESTS',
				'GENERATE_TESTS',
				'CODE_REVIEW',
				'CLEAN_UP_AND_REFACTOR',
			],
		},

		// Example to implement later
		design: {
			'READ_USER_STORIES',
			'MERMAID_MAP_SCREENS',
			'CREATE_WIREFRAMES',
			'GENERATE_DESIGNS',
		}
	}

	agents: [
		{
			name: "WRITE_USER_STORIES",
			model: "claude-sonnet-4-5",
			max_turns: 6,
			complete_turns: true,
			mcp_tools: {
				help: ['list_tools'],
				primary: ['write', 'read'],
				blacklist: ['httpie']
			},
			// Default built-in prompt, not required if file used
			prompt: 'You are a...'
			// Prompt file override (when stat finds the file)
			prompt_file: './prompts/WRITE_USER_STORIES.md'
		}
	]
}
```
