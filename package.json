		"@modelcontextprotocol/sdk": "^1.0.4",
		"openai": "^4.73.0",
		"commander": "^12.1.0",
		"dotenv": "^16.4.7",
		"chalk": "^5.3.0",
		"ora": "^8.1.1",
		"dockerode": "^4.0.2",
		"express": "^4.21.2",
		"cors": "^2.8.5"
	},
	"devDependencies": {},
	"engines": {
		"node": ">=20.0.0"
	}
}

