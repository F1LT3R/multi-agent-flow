{
	"name": "multi-agent-flow",
	"version": "0.1.0",
	"description": "AI agent orchestration system with Docker isolation and MCP servers",
	"type": "module",
	"main": "agent/cli.mjs",
	"bin": {
		"flow": "./agent/cli.mjs"
	},
	"scripts": {
		"test": "node --test agent/tests/*.test.mjs",
		"start": "node agent/cli.mjs"
	},
	"preferGlobal": true,
	"files": [
